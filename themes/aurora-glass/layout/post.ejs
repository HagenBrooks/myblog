<article class="article glass-card">
  <header class="article-header">
    <p class="eyebrow"><%= page.categories && page.categories.length ? page.categories.data[0].name : 'Blog Post' %></p>
    <h1><%= page.title %></h1>
    <time><%= date(page.date, 'YYYY 年 MM 月 DD 日') %></time>
  </header>
  <div class="article-content">
    <%- page.content %>
  </div>
</article>
